PORT=3000

# Sarvam AI Configuration (Get from https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shubh

# Twilio Account Credentials (Get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Twilio API Key & Secret (Optional)
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_secret

# Friend's Phone Number (Destination in E.164 format)
FRIEND_PHONE_NUMBER=+91xxxxxxxxxx

# Public HTTPS origin from Cloudflare Tunnel or ngrok
PUBLIC_BASE_URL=https://your-public-domain.ngrok-free.app

# Safety limits
MAX_CALL_SECONDS=180
MAX_DAILY_CALLS=5
VALIDATE_TWILIO_SIGNATURE=false
